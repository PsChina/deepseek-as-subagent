# Codex MCP registration for deepseek-as-subagent.
# Prefer `bash adapters/codex/install.sh` for automatic registration.

[mcp_servers.deepseek]
command = "/absolute/path/to/deepseek-as-subagent/.venv/bin/deepseek-mcp"

# The server exposes:
# - delegate_to_deepseek(task, context)          # synchronous
# - start_deepseek(task, context)                # returns job_id
# - send_deepseek_message(job_id, message)       # steer running job
# - get_deepseek_status(job_id)
# - cancel_deepseek(job_id)
# - get_deepseek_result(job_id)
# - ping()
#
# DeepSeek API credentials/config live in ~/.deepseek-mcp/config.json rather
# than this Codex config file.
