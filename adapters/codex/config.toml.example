# Codex MCP registration for deepseek-as-subagent.
# Prefer `bash adapters/codex/install.sh` for automatic registration.

[mcp_servers.deepseek] # managed-by: deepseek-as-subagent
command = "/absolute/path/to/.deepseek-mcp/codex-venvs/generation.XXXXXX/bin/deepseek-mcp"
enabled = true
enabled_tools = [
  "ping",
  "delegate_to_deepseek",
  "delegate_to_deepseek_readonly",
  "start_deepseek",
  "start_deepseek_readonly",
  "get_deepseek_status",
  "send_deepseek_message",
  "cancel_deepseek",
  "get_deepseek_result",
  "get_deepseek_recovery",
  "acknowledge_deepseek_mutations",
]
startup_timeout_sec = 20
tool_timeout_sec = 18060
default_tools_approval_mode = "writes"
env_vars = [
  "DEEPSEEK_API_KEY",
  "DEEPSEEK_WORKSPACE",
  "DEEPSEEK_MODE",
  "HTTP_PROXY",
  "HTTPS_PROXY",
  "ALL_PROXY",
  "NO_PROXY",
  "http_proxy",
  "https_proxy",
  "all_proxy",
  "no_proxy",
  "SSL_CERT_FILE",
  "SSL_CERT_DIR",
  "REQUESTS_CA_BUNDLE",
]

# Result retrieval performs local one-shot usage bookkeeping, so it is honestly
# annotated as a write while remaining safe to approve without a prompt.
[mcp_servers.deepseek.tools.get_deepseek_result]
approval_mode = "approve"

[mcp_servers.deepseek.tools.get_deepseek_recovery]
approval_mode = "approve"

[mcp_servers.deepseek.tools.acknowledge_deepseek_mutations]
approval_mode = "approve"

# The server exposes:
# - delegate_to_deepseek(task, context)          # coding, synchronous
# - delegate_to_deepseek_readonly(task, context) # read-only, synchronous
# - start_deepseek(task, context)                # coding, returns job_id
# - start_deepseek_readonly(task, context)       # read-only, returns job_id
# - send_deepseek_message(job_id, message)       # steer running job
# - get_deepseek_status(job_id)
# - cancel_deepseek(job_id)
# - get_deepseek_result(job_id)
# - get_deepseek_recovery()
# - acknowledge_deepseek_mutations(transaction_ids)
# - ping()
#
# DeepSeek API credentials/config live in ~/.deepseek-mcp/config.json rather
# than this Codex config file.
